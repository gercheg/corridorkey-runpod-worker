# Upstream / reference snapshots (cloned for inspection only)
CorridorKey_src/
loremax-build-worker_ref/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Model weights / large binaries baked into images, never tracked
*.pth
*.pt
*.safetensors
*.onnx
*.ckpt
*.bin
BiRefNetModule/checkpoints/
CorridorKeyModule/checkpoints/
.huggingface/

# Raw test footage — tracked via MANIFEST.json + CHECKSUMS.txt only
source/*.mp4
source/*.mov
source/*.mkv
source/*.webm
source/*.avi
!source/.gitkeep

# Build / tmp artefacts
_ck_job/
tests/local/
outputs/
tmp/
*.log
*.tmp
*.zip

# Pod-side runtime artefacts pulled down during testing — reports in
# *_SUMMARY.md cover what matters, the raw dumps are too large to track.
worker/artifacts/

# Decoded smoke-test outputs — regenerated by deploy/smoke_test.ps1.
worker/deploy/smoke_out/
worker/deploy/big_loremax_out/

# Lora chromakey generated media is published on Loremax CDN and reproducible
# from the committed manifest. Keep local binaries/full base64 responses out.
worker/deploy/lora_chromakey/*
!worker/deploy/lora_chromakey/
!worker/deploy/lora_chromakey/MANIFEST.json
!worker/deploy/lora_chromakey/README.md
!worker/deploy/lora_chromakey/reupload_artifacts.ps1

# One-off GPU price comparison raw responses and decoded media. The selected
# endpoint and timings are documented in dify_plugin/README.md.
worker/deploy/cheap48_*.json
worker/deploy/cheap48_compare/
worker/deploy/cheap48_compare_report.html
worker/deploy/build_cheap48_report.py
worker/deploy/dify_plugin/out_*/

# Docker
docker-build.log

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
